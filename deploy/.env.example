# Production settings for deploy/docker-compose.yml.
# Copy to deploy/.env (never committed) and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # secret key
#   python -c "import secrets; print(secrets.token_hex(24))"       # DB password
# Values here are read literally: no quotes, no inline comments after values.

# ── Public address ───────────────────────────────────────────
# Hostname Caddy serves and gets the HTTPS certificate for ("localhost" for a local trial).
SITE_ADDRESS=localhost
DJANGO_ALLOWED_HOSTS=localhost
# Frontend origin(s), comma-separated. Must be the SAME SITE as SITE_ADDRESS
# (same host, or subdomains of one domain) for the login cookie to work.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=
# Something unguessable, with a trailing slash.
DJANGO_ADMIN_URL=admin/
ENABLE_API_DOCS=False
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── PostgreSQL (the db container creates this user/database on first start) ──
POSTGRES_USER=tuition
# Letters and digits only (it goes inside a URL): use token_hex above.
POSTGRES_PASSWORD=
POSTGRES_DB=tuition
# On the 24 GB Oracle server: 4GB / 12GB / 32MB / 512MB.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB

# ── Gunicorn ─────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# ── Email (Brevo SMTP in production) ─────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Google Sign-In / Drive (same meaning as backend/.env.example) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ── Backups (nightly at BACKUP_TIME, India time) ─────────────
BACKUP_TIME=02:30
BACKUP_KEEP=14
BACKUP_TO_DRIVE=True

# ── Optional error tracking ──────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
