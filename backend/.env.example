# "json" on hosting platforms that parse structured logs.
LOG_FORMAT=text
# Requests slower than this (ms) are logged as warnings.
SLOW_REQUEST_MS=1000

# ── Security & monitoring (Phase 7) ──────────────────────────
# Move the Django admin off the guessable /admin/ in production (keep the trailing slash).
DJANGO_ADMIN_URL=admin/
# Enable only once the final domain is permanently on HTTPS (hard to undo).
# SECURE_HSTS_PRELOAD=False
# Optional error tracking. Leave empty to disable. No personal data is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
