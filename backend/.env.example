# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit it.

# ── Django ───────────────────────────────────────────────────
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
# (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgres://tms_user:change-me@localhost:5432/tms_db
DB_CONN_MAX_AGE=60

# ── Cache (rate limiting) ────────────────────────────────────
# Default: PostgreSQL table (run `python manage.py createcachetable` once).
# Later, for Redis: CACHE_URL=redis://localhost:6379/0
CACHE_URL=dbcache://django_cache

# ── JWT ──────────────────────────────────────────────────────
# Optional separate signing key (defaults to DJANGO_SECRET_KEY)
# JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Two refreshes with the same token within this window both succeed (two tabs).
REFRESH_ROTATION_GRACE_SECONDS=30
# A login must be repeated after this many days, however active.
SESSION_MAX_LIFETIME_DAYS=30

# ── CORS / CSRF (frontend origin) ────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── API docs ─────────────────────────────────────────────────
ENABLE_API_DOCS=True

# ── Throttling ───────────────────────────────────────────────
THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_OTP_REQUEST=20/hour
THROTTLE_RATE_OTP_VERIFY=60/hour

# ── OTP authentication ───────────────────────────────────────
INSTITUTE_NAME=SPT Tuition Classes
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
DEFAULT_PHONE_COUNTRY_CODE=+91
# Development prints SMS to the terminal. Replace with a real gateway in production.
SMS_BACKEND=apps.accounts.services.sms.ConsoleSMSBackend

# ── Email (OTP). Console backend prints emails to the terminal. ─
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@localhost

# ── Google Sign-In ───────────────────────────────────────────
# OAuth *Client ID* from Google Cloud → APIs & Services → Credentials (not a secret).
GOOGLE_OAUTH_CLIENT_ID=
# Optional extra accepted client IDs (e.g. a future mobile app), comma-separated.
# GOOGLE_EXTRA_AUDIENCES=

# ── Uploads & logging ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
